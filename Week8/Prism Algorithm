#include <bits/stdc++.h>
using namespace std;

int main() {
    int V;
    cout << "Enter number of vertices: ";
    cin >> V;

    vector<vector<int>> graph(V, vector<int>(V));

    cout << "Enter adjacency matrix:\n";
    for(int i = 0; i < V; i++) {
        for(int j = 0; j < V; j++) {
            cin >> graph[i][j];
        }
    }

    vector<int> key(V, INT_MAX);
    vector<bool> mst(V, false);

    key[0] = 0;
    int totalCost = 0;

    for(int i = 0; i < V; i++) {
        int u = -1;

        for(int j = 0; j < V; j++) {
            if(!mst[j] && (u == -1 || key[j] < key[u])) {
                u = j;
            }
        }

        mst[u] = true;
        totalCost += key[u];

        for(int v = 0; v < V; v++) {
            if(graph[u][v] != 0 && !mst[v]) {
                key[v] = min(key[v], graph[u][v]);
            }
        }
    }

    cout << "Minimum Spanning Weight (Prim): " << totalCost << endl;

    return 0;
}
